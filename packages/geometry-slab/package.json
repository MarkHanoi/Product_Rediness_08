{
  "name": "@pryzm/geometry-slab",
  "version": "0.1.0",
  "description": "PRYZM \u2014 slab geometry subsystem. Types, store, fragment builder, validators, sketch resolver utilities.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./geom-utils": "./src/SlabGeomUtils.ts",
    "./store": "./src/SlabStore.ts",
    "./region-tracer": "./src/SlabRegionTracer.ts",
    "./region-boundary": "./src/RegionBoundarySources.ts",
    "./boundary-arc": "./src/boundaryArc.ts",
    "./boundary-loops": "./src/boundaryLoops.ts",
    "./type-catalogue": "./src/SlabTypeCatalogue.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pryzm/geometry-kernel": "workspace:*",
    "@pryzm/core-app-model": "workspace:*",
    "@pryzm/renderer-three": "workspace:*",
    "@pryzm/frame-scheduler": "workspace:*",
    "@pryzm/geometry-wall": "workspace:*",
    "@pryzm/command-registry": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
