{"type":"FeatureCollection","features":[{"type":"Feature","id":"theme_pdk_kommuneplanramme_vedtaget_v.2852812","geometry":{"type":"MultiPolygon","coordinates":[[[[10.2091918177,56.156669984],[10.2092505541,56.1567151453],[10.2092559504,56.1567126665],[10.2094165195,56.1568371615],[10.2094078928,56.1568393126],[10.2094588841,56.1568787989],[10.2098294228,56.1571472524],[10.2099614074,56.1572227862],[10.2101903128,56.1576361231],[10.2103076827,56.1575898667],[10.2103504301,56.1576026567],[10.2110579998,56.1574829576],[10.2112179758,56.1574910943],[10.2113755535,56.1574741847],[10.2113764488,56.1574770513],[10.2115566876,56.1574588411],[10.2116298016,56.1574440172],[10.2117047583,56.157400781],[10.2117066576,56.1573741654],[10.211635733,56.1571311746],[10.2114618876,56.1568818246],[10.2114522454,56.156831241],[10.2113610194,56.1566388576],[10.211310837,56.1566046655],[10.2112460031,56.1565039448],[10.2112483397,56.1564554003],[10.2112937295,56.1561224029],[10.211284764,56.1561188966],[10.211305019,56.1560411534],[10.2113847213,56.1555348493],[10.2113074956,56.1555161077],[10.2105556962,56.1559023017],[10.2101937388,56.1561421645],[10.2099346296,56.1562786749],[10.2094678777,56.1565245035],[10.2091918177,56.156669984]]]]},"geometry_name":"geometri","properties":{"oid":2852812,"id":2852812,"planid":11714778,"objektkode":10,"komplan_id":11714748,"komtil_id":null,"plantype":10.1,"plannavn":"Kommuneplan 2025","plannr":"010109CY","distrikt":"Midtbyen","anvgen":41,"fzone":1,"zone":null,"datoforsl":20250625,"datovedt":20251217,"datoaflyst":null,"datoikraft":20260119,"datostart":20250627,"datoslut":20250914,"saflysdato":null,"datooprt":"2025-01-13T16:43:16.676Z","datoopdt":"2026-01-19T14:36:11.212Z","planstatus":"V","komnr":751,"doklink":"https://dokument.plandata.dk/11_11714748_1768833193079.pdf","datoattr":20260119,"datogeom":20250113,"minmiljo":null,"maxmiljo":null,"notanvgen":"Områdets anvendelse er fastlagt til cityformål.\nCityformål omfatter funktioner til handel, kultur og service, (f.eks. butikker, kontorer, hoteller, biografer, udstillingslokaler), offentlige funktioner og sådanne andre funktioner, der med fordel kan placeres i et center af regional betydning, og ende¬lig boliger, der kan forenes med cityfunktionen. Som hovedregel må boliger ikke placeres i stueetagen. \nOmrådet kan desuden anvendes til offentlige formål og boliger.\nDer er fastlagt en samlet ramme for Cityområdet som helhed på 250.000 m² bruttoetageareal. Butiksarealets omfang er fastlagt efter, hvad der vurderes at være behov for til fastholdelse og udvikling af City som kommunens hovedcenter. Den enkelte butiks maksimale bruttoetageareal er indskrevet i rammerne, fordelt på dagligvarebutikker og udvalgsvarebutikker,  \nVed planlægning for placering af butikker, der forhandler særligt pladskrævende varegrupper efter planlovens definition, er der mulighed for, at der kan planlægges for butikker med et større maksimalt bruttoetageareal end anført i rammerne.\nDer kan inden for disse rammeområder stilles krav i lokalplaner om, at op til 25% af boligetagearealet skal være almene boliger i de tilfælde, hvor lovgivningens vilkår herfor er opfyldt.","notomranv":"Anvendelsen af området er fastlagt til offentlige formål i form af kirke, teater, museer og lignende. Yderligere byggeri i området kan kun finde sted nord for Domkirkepladsen. For at opnå en god bygningsmæssig helhedsvirkning kan der i forbindelse med opførelse af ny bebyggelse samt ved ombygningsprojekter, der vedrører bebyggelsens ydre, stilles særlige krav til bygningernes proportionering, taghældning, tagkviste, materialevalg mv.","notbebygom":"Den maksimale bebyggelsesprocent beregnes for arealet mellem Rosensgade og Domkirkepladsen under ét. Butikker må kun etableres i tilknytning til områdets funktioner.","notophold":null,"notmiljo":"Der er kortlagt fare for oversvømmelse i dele af området, jf. udpegninger af områder for hhv. ’Oversvømmelse fra ekstremregn’, ’Oversvømmelse fra vandløb og søer’ og ’Oversvømmelse ved stormflod’.   Ved fremtidig planlægning af området skal faren for oversvømmelse vurderes nærmere via undersøgelse af lokal hydrologi. Derefter skal det vurderes, om/hvordan området kan disponeres og afværgeforanstaltninger realiseres, så oversvømmelsen håndteres hensigtsmæssigt i forhold til at forebygge oversvømmelse af bygninger, infrastruktur og hotspots. Lokalplanlægningen skal herefter indarbejde bestemmelser om nødvendige afværgeforanstaltninger.","notinfras":null,"notzone":null,"notlokalp":null,"notat":null,"dataprod":null,"digigrundl":null,"digigrundd":null,"anvendelsegenerel":"Centerområde","zonestatus":null,"fremtidigzonestatus":"Byzone","sforhold":null,"minuds":null,"bebygpct":180,"bebygpctaf":1,"eareal":16800,"earealh":1,"m3_m2":null,"m3_m2h":null,"maxbygnhjd":null,"maxetager":4,"bebygpctar":null,"iomfangreg":false,"iudstykreg":true,"vindbeskriv":null,"udstykforbud":null,"sforaktuel":false,"begroenning":null,"maxboligenhed":null,"udstykantal":null,"maxuds":null,"bygpctarh":null,"bygm2":null,"bygm2h":null,"fuldtbyg":null,"anvspec1":4115,"bygpct1":null,"bygpcth1":null,"eareal1":null,"earealh1":null,"m3_m21":null,"m3_m2h1":null,"maxbhjd1":null,"maxetage1":null,"bygpctar1":null,"bygpctarh1":null,"bygm21":null,"bygm2h1":null,"minuds1":null,"udstykfb1":null,"fuldtbyg1":null,"plankap1":null,"plankapia1":null,"forvprod1":null,"forvprodia1":null,"maxboligenhed1":null,"udstykantal1":null,"maxuds1":null,"antal1":null,"anvspec2":null,"bygpct2":null,"bygpcth2":null,"eareal2":null,"earealh2":null,"m3_m22":null,"m3_m2h2":null,"maxbhjd2":null,"maxetage2":null,"bygpctar2":null,"bygpctarh2":null,"bygm22":null,"bygm2h2":null,"minuds2":null,"udstykfb2":null,"fuldtbyg2":null,"plankap2":null,"plankapia2":null,"forvprod2":null,"forvprodia2":null,"maxboligenhed2":null,"udstykantal2":null,"maxuds2":null,"antal2":null,"anvspec3":null,"bygpct3":null,"bygpcth3":null,"eareal3":null,"earealh3":null,"m3_m23":null,"m3_m2h3":null,"maxbhjd3":null,"maxetage3":null,"bygpctar3