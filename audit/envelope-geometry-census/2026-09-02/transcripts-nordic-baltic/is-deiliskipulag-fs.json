lseX":-34541500,"falseY":-31559400,"xyUnits":10000,"falseZ":-100000,"zUnits":10000,"falseM":-100000,"mUnits":10000}},"fullExtent":{"xmin":244283.96429999918,"ymin":321403.50979999825,"xmax":751821.8520999998,"ymax":667799.4875000007,"spatialReference":{"wkid":3057,"latestWkid":3057,"xyTolerance":0.001,"zTolerance":0.001,"mTolerance":0.001,"falseX":-34541500,"falseY":-31559400,"xyUnits":10000,"falseZ":-100000,"zUnits":10000,"falseM":-100000,"mUnits":10000}},"allowGeometryUpdates":true,"allowTrueCurvesUpdates":true,"onlyAllowTrueCurveUpdatesByTrueCurveClients":true,"supportsApplyEditsWithGlobalIds":false,"supportsTrueCurve":true,"units":"esriMeters","documentInfo":{"Title":"Deiliskipulagsmörk","Author":"","Comments":"Deiliskipulag nær til afmarkaðs svæðis sem myndar heildstæða einingu - hverfis, hverfishluta, götureits eða húsaþyrpingar. Þar eru sett ákvæði um byggingarheimildir og útfærslu bygginga og frágang umhverfis.Afmarkanir eru ónákvæmar og sýna ekki alltaf mörk skipulagssvæðis með fullkomlega réttum hætti. Þeim er fyrst og fremst ætlað að sýna hvar deiliskipulag er fyrir hendi.Afmarkanirnar byggja á deiliskipulagsáætlunum sveitarfélaga og eru uppfærð til samræmis við breytingar sem verða á deiliskipulagsáætlunum.Ef deiliskipulagsgögn birtast ekki undir svæðisafmörkun í Skipulagsvefsjá getur það skýrst af því að beðið er eftir gildistöku deiliskipulagsins, beðið er eftir lagfærðum gögnum frá sveitarfélaginu eða að mistök hafa verið gerð við innsetningu gagna. Hægt er að hafa samband við Skipulagsstofnun eða viðkomandi sveitarfélag til að fá nánari upplýsingar.","Subject":"Afmarkanir eru ónákvæmar og sýna ekki alltaf mörk skipulagssvæðis með fullkomlega réttum hætti. Þeim er fyrst og fremst ætlað að sýna hvar deiliskipulag er fyrir hendi.","Category":"","Keywords":"deiliskipulag,Skipulagsstofnun"},"supportsQueryDomains":true,"supportsQueryContingentValues":true,"layers":[{"id":0,"name":"Skipulagsmörk","parentLayerId":-1,"defaultVisibility":true,"subLayerIds":nul