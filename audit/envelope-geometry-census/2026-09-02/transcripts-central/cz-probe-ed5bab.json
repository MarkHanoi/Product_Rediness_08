<script>
	window.pageGuestAccessible = true;

	(function () {
		async function updatePageGuestAccessible() {
			try {
				const response = await fetch(window.location.href, {
					credentials: 'same-origin',
					headers: {
						Accept: 'text/html'
					}
				});

				const html = await response.text();
				const documentFragment = new DOMParser().parseFromString(html, 'text/html');
				const valueElement = documentFragment.getElementById('ngup-page-guest-accessible-value');

				if (!valueElement) {
					return window.pageGuestAccessible;
				}

				const pageGuestAccessible = valueElement.textContent.trim() === 'true';

				setPageGuestAccessible(pageGuestAccessible);

				return pageGuestAccessible;
			}
			catch (error) {
				console.error('Unable to check Guest VIEW permission for the current page.', error);

				return window.pageGuestAccessible;
			}
		}

		function setPageGuestAccessible(value) {
			window.pageGuestAccessible = value;
			window.dispatchEvent(new CustomEvent('pageGuestAccessibleChanged', {
				detail: {
					pageGuestAccessible: value
				}
			}));
		}

		window.updatePageGuestAccessible = updatePageGuestAccessible;

		if (window.Liferay && Liferay.on) {
			Liferay.on('endNavigate', function () {
				setTimeout(updatePageGuestAccessible, 0);
			});
		}
	})();
</script>
