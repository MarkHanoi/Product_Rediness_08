<script>
	(() => {
		const signOutButton = document.getElementById('ngup-mobile-sign-out-button');

		if (!signOutButton) {
			return;
		}

		signOutButton.addEventListener('gov-click', (event) => {
			event.preventDefault();

			const logoutUrl = signOutButton.getAttribute('href');
			const channel = new BroadcastChannel('ngup');

			channel.postMessage({ type: 'logout' });
			channel.close();

			window.location.href = logoutUrl;
		});
	})();
</script>

		
	







