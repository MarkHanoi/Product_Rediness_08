			<script>
				setTimeout(() => {
						const loggedInUserButton = document.querySelector('#logged-in-user-button .element');
						const loggedInUserMenuItems = document.querySelector('#logged-in-user-menu-items');
						const loggedInUserMenuBack = document.querySelector('#logged-in-user-menu-back');

						const mobileMainMenuItems = document.querySelector('#mobile-main-menu-items');
						const mobileLoggedInUserButton = document.querySelector('#mobile-logged-in-user-button');
						const mobileLoggedInUserAisButton = document.querySelector('#mobile-logged-in-user-ais-button');
						const mobileLoggedInUserLogOutButton = document.querySelector('#mobile-logged-in-user-log-out-button');
						const mobileLoginButton = document.querySelector('#mobile-log-in-button');

						if (loggedInUserButton) {
							loggedInUserButton.addEventListener('click', () => {
								loggedInUserMenuItems.classList.remove('tw-hidden');
								mobileMainMenuItems.classList.add('tw-hidden');
								mobileLoggedInUserButton.classList.add('tw-hidden');
								mobileLoggedInUserAisButton.classList.remove('tw-hidden');
								mobileLoggedInUserLogOutButton.classList.remove('tw-hidden');
							});
						}

						// Chevron left logged in user back menu button
						if (loggedInUserMenuBack) {
							// i want to show old mobileMainMenuItems
							// logged in user buttton
							loggedInUserMenuBack.addEventListener('click', () => {
								loggedInUserMenuItems.classList.add('tw-hidden');
								mobileMainMenuItems.classList.remove('tw-hidden');
								mobileLoggedInUserButton.classList.remove('tw-hidden');
								mobileLoggedInUserAisButton.classList.add('tw-hidden');
								mobileLoggedInUserLogOutButton.classList.add('tw-hidden');
							});
						}
					}, 500);

				function toggleMenu() {
					const menu = document.getElementById('mobile-menu');
					const hamburger = document.getElementById('hamburger-to-cross');

					// Toggle visibility of the menu
					menu.classList.toggle('tw-hidden');

					// Change the hamburger icon to a cross when the menu is open
					if (!menu.classList.contains('tw-hidden')) {
						hamburger.innerHTML = `
	<svg class="tw-h-6 tw-w-6 text-slate-700" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">  <path stroke="none" d="M0 0h24v24H0z"></path>  <line x1="18" y1="6" x2="6" y2="18"></line>  <line x1="6" y1="6" x2="18" y2="18"></line></svg>
  `;
						document.body.classList.add('tw-overflow-hidden');
					} else {
						hamburger.innerHTML = `
	<div class="tw-w-6 tw-h-0.5 tw-bg-white"></div>
	<div class="tw-w-6 tw-h-0.5 tw-bg-white"></div>
	<div class="tw-w-6 tw-h-0.5 tw-bg-white"></div>
  `;
						document.body.classList.remove('tw-overflow-hidden');
					}
				}
			</script>


