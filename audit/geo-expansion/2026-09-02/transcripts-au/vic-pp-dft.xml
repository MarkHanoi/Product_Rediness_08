<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:open-data-platform="http://www.delwp.vic.gov.au/open-data-platform" xmlns:wfs="http://www.opengis.net/wfs/2.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://www.delwp.vic.gov.au/open-data-platform">
  <xsd:import namespace="http://www.opengis.net/gml/3.2" schemaLocation="http://opendata.maps.vic.gov.au/geoserver/schemas/gml/3.2.1/gml.xsd"/>
  <xsd:complexType name="parcel_propertyType">
    <xsd:complexContent>
      <xsd:extension base="gml:AbstractFeatureType">
        <xsd:sequence>
          <xsd:element maxOccurs="1" minOccurs="0" name="ufi" nillable="true" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="parcel_pfi" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="property_pfi" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="ufi_created" nillable="true" type="xsd:dateTime"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:element name="parcel_property" substitutionGroup="gml:AbstractFeature" type="open-data-platform:parcel_propertyType"/>
</xsd:schema>
