node_modules/
dist/
# Apex pre-render output — generated by `pnpm build:apex` (ADR-055 §0 / C51 §6.1).
# Cloudflare Pages rebuilds this from source; a committed copy would only drift.
dist-apex/
**/dist-apex/
# §L-442 — precompiled server dependencies (scripts/build/build-server-deps.mjs).
# Deliberately OUTSIDE dist/: dist/ is served by express.static, and these bundles
# ship .map files containing server-side source. Consumed by
# scripts/build/apply-server-deps-overlay.mjs, never served.
dist-server-deps/
# Lane 4E's VERIFY-harness vite output. 36 MB of it was committed by accident in
# `f564b892`; nothing in the estate reads it (only the lane's own audit transcript
# names the path). Ignored so it is never re-committed; the 54 files already tracked
# still need an explicit `git rm -r lane4e-dist`.
lane4e-dist/
.cache/
*.log
.DS_Store
.env
.env.local
.env.*.local
!.env.example

# §H30 — TypeScript incremental build cache must never be committed
*.tsbuildinfo

# §H28 — Claude chat-paste history / scratchpad — not source
attached_assets/
.agents/attached_assets/

# Claude Code background-agent worktrees — runtime checkouts, NOT source.
# Each is a full repo copy; on Windows the deep node_modules paths exceed
# MAX_PATH so `git worktree remove` can fail to delete them, leaving tens of
# thousands of untracked files showing as bogus "changes". Never track these.
.claude/worktrees/

# §L6 — local developer scratch files (TypeScript error dumps, etc.)
.local/
.local-*.txt

# Terrain/context bake output + standalone (non-workspace) deps — ephemeral, rebuilt in CI
# (terrain.mjs / bake.mjs write here; terrain-bake.yml installs deps standalone). Never source.
tools/context-bake/out/
tools/context-bake/package-lock.json
.local-*.json

# §A.31.e fix — MasterMiawW is a REFERENCE chatbot repo (see memory note
# mastermiaww-rac-chatbot-reference). Lives as its own git repo at
# ./MasterMiawW/ but is NOT a submodule of this repo (no .gitmodules).
# Excluded so it doesn't re-appear in git's index + break Cloudflare clones.
MasterMiawW/

# Visual Studio IDE caches (CodeChunks.db, workspace state, semantic symbols)
.vs/
# .NET build output (revit-addin)
revit-addin/**/obj/
revit-addin/**/bin/
tools/rac-conformance/runtime-harness/.liveness-output/

# §CLEAN-SOURCE-CONTROL (2026-08-13) — scratch probe dirs from measurement
# sessions, and bench run outputs that regenerate on every run. Committing
# either makes every unrelated diff noisy and hides real changes.
.probe-tmp/
.tmp-verbs-cap/
.w2a-tmp/
apps/bench/.run-output/

# §TEXTURE-PIPELINE (L-1720) — acquired/compressed texture binaries.
# The bytes live in R2, NOT in git; textures.manifest.json carries a SHA-256 for every
# file, so the set stays verifiable without adding ~47MB of binaries to the repo.
# (public/items already demonstrates the cost of the other choice: ~185MB of GLB that
# must then be .dockerignore-d back out of the image.)
tools/texture-pipeline/out/

# playwright output (regenerable)
test-results/

# §VIDEO-SOURCE — 916 MB of camera/master footage (PRYZM.mp4 737 MB, pryzm-hero-1080p.mp4 178 MB).
# GitHub hard-rejects any blob over 100 MB, so a commit carrying these can never be pushed. The
# SHIPPED derivatives live in public/apex/ (hero-hevc.mp4, hero.mp4) and ARE tracked; these are the
# masters they are cut from and belong on disk, not in history.
docs/04-reference/Video/

# family-migrations UTF-8 emit scratch (tooling artefact, never source)
packages/file-format/.u8emit/
packages/file-format/.u8emit.tsconfig.json

# §LANE-VERIFY-SCRATCH (2026-09-07) — fleet lanes write their gate captures, vitest
# baselines and de-conflict patches here while they verify. 56 files at one point,
# which read as "60 uncommitted changes" in the editor and hid the real ones.
# Tooling artefacts, never source.
.verify-tmp/
scratch_*.txt
apps/editor/tsconfig.lane-*.json
