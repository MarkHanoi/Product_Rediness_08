node_modules/
dist/
# Apex pre-render output — generated by `pnpm build:apex` (ADR-055 §0 / C51 §6.1).
# Cloudflare Pages rebuilds this from source; a committed copy would only drift.
dist-apex/
**/dist-apex/
# §L-442 — precompiled server dependencies (scripts/build/build-server-deps.mjs).
# Deliberately OUTSIDE dist/: dist/ is served by express.static, and these bundles
# ship .map files containing server-side source. Consumed by
# scripts/build/apply-server-deps-overlay.mjs, never served.
dist-server-deps/
.cache/
*.log
.DS_Store
.env
.env.local
.env.*.local
!.env.example

# §H30 — TypeScript incremental build cache must never be committed
*.tsbuildinfo

# §H28 — Claude chat-paste history / scratchpad — not source
attached_assets/
.agents/attached_assets/

# Claude Code background-agent worktrees — runtime checkouts, NOT source.
# Each is a full repo copy; on Windows the deep node_modules paths exceed
# MAX_PATH so `git worktree remove` can fail to delete them, leaving tens of
# thousands of untracked files showing as bogus "changes". Never track these.
.claude/worktrees/

# §L6 — local developer scratch files (TypeScript error dumps, etc.)
.local/
.local-*.txt

# Terrain/context bake output + standalone (non-workspace) deps — ephemeral, rebuilt in CI
# (terrain.mjs / bake.mjs write here; terrain-bake.yml installs deps standalone). Never source.
tools/context-bake/out/
tools/context-bake/package-lock.json
.local-*.json

# §A.31.e fix — MasterMiawW is a REFERENCE chatbot repo (see memory note
# mastermiaww-rac-chatbot-reference). Lives as its own git repo at
# ./MasterMiawW/ but is NOT a submodule of this repo (no .gitmodules).
# Excluded so it doesn't re-appear in git's index + break Cloudflare clones.
MasterMiawW/

# Visual Studio IDE caches (CodeChunks.db, workspace state, semantic symbols)
.vs/
# .NET build output (revit-addin)
revit-addin/**/obj/
revit-addin/**/bin/
